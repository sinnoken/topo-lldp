###############################################################################
# 1. 換行符號自動化 (Line Endings)
###############################################################################
# 自動偵測文字檔，確保存入 Git 時為 LF，在 Windows 拉取時轉為 CRLF
* text=auto

# 強制 RouterOS 腳本與 Shell 腳本永遠使用 LF (避免在 Router 上噴錯)
*.sh  text eol=lf

###############################################################################
# 2. 減少 Git 噪音與過濾 (Noise Reduction)
###############################################################################
# 配合 Git Filter 忽略時間戳 (需在 Workflow 執行 git config)
*.txt filter=ignore-timestamp
*.rsc filter=ignore-timestamp

# 標記自動產生的檔案：GitHub 統計語言比例時會跳過它們，且預設隱藏 Diff
# 這樣你的 Repo 就不會被標記為 "99% Text"，而是顯示正確的 "Python"
asn_*.txt linguist-generated=true
*.rsc     linguist-generated=true

# 對於巨大的數據檔，禁止 Git 在網頁顯示具體 Diff (避免瀏覽器卡死)
asn_*.txt -diff
*.rsc     -diff

###############################################################################
# 3. 二進位檔案處理 (Binary Files)
###############################################################################
# 確保 SQLite 資料庫被當作二進位處理，防止 Git 試圖修正換行符號導致檔案損壞
*.sqlite  binary
*.db      binary
*.dat     binary

###############################################################################
# 4. 匯出優化 (Export Settings)
###############################################################################
# 當有人下載 Repo 壓縮檔 (ZIP) 時，排除掉開發用的設定與 GitHub 工作流
.github/        export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
